+    )
+)
+
+fig.update_layout(
+    title=TITLE,
+    xaxis_title="Fiscal Year",
+    yaxis_title=y_title,
+    template="plotly_white",
+    margin=dict(l=70, r=20, t=80, b=60),
+)
+
+# Save interactive HTML
