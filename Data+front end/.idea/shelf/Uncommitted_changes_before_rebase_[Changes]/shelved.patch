+    per_company = 25
+    fig_width = max(base_width, per_company * max(1, len(df)))
+
+    fig = make_subplots(
+        rows=1, cols=2,
+        specs=[[{"type": "xy"}, {"type": "domain"}]],
+        column_widths=COL_WIDTHS,
+        horizontal_spacing=HSPACE,
+        subplot_titles=[None, "Overall (This Selection)"]
+    )
+
+    x_vals = df["ticker"]
