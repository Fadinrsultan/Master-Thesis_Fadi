+def sec_row_to_fact(tag: str, r: Dict[str, Any]) -> Dict[str, Any]:
+    return {
+        "tag": tag, "value": r.get("val"), "unit": r.get("uom"),
+        "fy": r.get("fy"), "fp": r.get("fp"), "form": r.get("form"),
+        "filed": r.get("filed"), "accn": r.get("accn"),
+        "end": r.get("end"), "start": r.get("start")
