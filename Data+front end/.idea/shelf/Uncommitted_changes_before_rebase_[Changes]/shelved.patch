+
+    print(f"\n▶ {tkr} (CIK {cik})")
+    data = {"ticker": tkr, "cik": cik, "financials_by_fy": {}}
+
+    # Collect facts by FY
+    primary_by_metric_fy: Dict[str, Dict[int, Dict[str, Any]]] = defaultdict(dict)
